# Apache Superset 6.1.0 — PostgreSQL password
SUPERSET_PASSWORD=changeme

# Superset config
SUPERSET_SECRET_KEY=changeme_superset_secret_key

# Admin credentials
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# K8s settings
NAMESPACE=demo1
DOMAIN=local.lan
SUPERSET_HOST=superset.${NAMESPACE}.${DOMAIN}

# Docker image (set after building superset-fix)
# IMAGE=apache/superset:6.1.0   # default — lacks psycopg2
# IMAGE=apachesuperset.docker.scarf.sh/apache/superset:6.1.0  # Scarf proxy
IMAGE=amancevice/superset:6.1.0  # includes psycopg2
