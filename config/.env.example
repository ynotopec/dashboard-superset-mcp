# Superset K8s deployment configuration
# Copy this file to config/.env and edit

# K8s namespace
NAMESPACE=demo1

# Domain suffix (builds SUPERSET_HOST)
DOMAIN=local.lan

# PostgreSQL
SUPERSET_PASSWORD=changeme

# Superset
SUPERSET_SECRET_KEY=changeme_superset_secret_key

# Admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Full hostname
# SUPERSET_HOST=superset.${NAMESPACE}.${DOMAIN}
